# ============================================================
# arena_new — Backend Platform
# ============================================================
# Copy this file to `.env` for local development.
# Production values are injected by Dokploy environment configuration.
# NEVER commit a real `.env` file.
#
# PR-00 canonical configuration contract — every variable in this file
# has a corresponding typed field in apps/backend/internal/platform/config/config.go.
# Variables not present in Config.Load() are explicitly removed from this file.

# ---- Application ----
# One of: development | staging | production
APP_ENV=development
# Service name used in logs and tracing
APP_NAME=arena-api
# Semver populated by CI at build time
APP_VERSION=0.1.0-dev
# Git SHA populated by CI at build time
APP_COMMIT=local
# Canonical public SPA origin used in emails and webhooks (for example,
# https://app.example.com). Required in production when EMAIL_MODE=smtp.
# It is distinct from VITE_API_BASE_URL: email links land in the SPA, which
# calls the API separately; links are never derived from request headers.
APP_PUBLIC_URL=

# ---- HTTP server ----
HTTP_LISTEN_ADDR=:8080
# Maximum allowed request body in bytes (1 MiB default)
BODY_LIMIT_BYTES=1048576
# Per-request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30
# Comma-separated allowlist of origins for CORS, or "*" for dev.
# Wildcard is FORBIDDEN in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Graceful shutdown window
SHUTDOWN_TIMEOUT=20s
# Explicit healthcheck target address (defaults to HTTP_LISTEN_ADDR for api,
# WORKER_METRICS_ADDR for worker). Dokploy and PR-05 use this.
HEALTH_ADDR=
# Number of trusted reverse-proxy hops in front of this process. When 0
# (default), X-Forwarded-For is ignored and RemoteAddr is used for rate
# limiting — safe for direct-to-server deployments. Set to 1 behind one
# nginx/Caddy proxy, 2 behind two hops, etc. Higher values than the actual
# proxy depth allow clients to spoof their IP and bypass rate limits.
TRUSTED_PROXY_COUNT=0

# ---- Database (PostgreSQL 17) ----
# pgx DSN — must use sslmode=require or verify-full in production
DATABASE_URL=postgres://arena:arena@postgres:5432/arena?sslmode=disable
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONNS=20
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m
# Set to true to log every SQL statement (slow; dev only).
# FORBIDDEN in production: leaks PII and degrades performance.
DB_LOG_QUERIES=false
# Set true only for an in-network PostgreSQL container without TLS. Production
# accepts this only for an unqualified Docker host or a private/local IP.
ALLOW_PRIVATE_DB_PLAINTEXT=false

# ---- Redis (locks / hot caches; PostgreSQL remains source of truth) ----
REDIS_URL=redis://redis:6379/0

# ---- Auth / JWT ----
# Enable the dev-only stub IdentityProvider. Must be false in production.
ENABLE_DEV_AUTH=true
# HMAC-SHA256 signing secret for JWT issuance and verification.
# Production requires >= 32 bytes and must NOT be a known dev placeholder.
JWT_SIGNING_SECRET=dev-only-do-not-use-in-prod
JWT_ISSUER=arena-dev
JWT_AUDIENCE=arena-api
JWT_DEFAULT_TTL=1h

# ---- Idempotency ----
# Time-to-live for stored idempotency keys
IDEMPOTENCY_TTL=24h
# Maximum length of the Idempotency-Key header value
IDEMPOTENCY_KEY_MAX_LENGTH=255

# ---- Internationalization ----
# Default locale when negotiation finds no match
DEFAULT_LOCALE=en
# Comma-separated list of active locales
ACTIVE_LOCALES=ru,en

# ---- Observability ----
# slog level: debug | info | warn | error
LOG_LEVEL=info
# Output format: json | text  (production MUST be json)
LOG_FORMAT=text
# OpenTelemetry OTLP gRPC endpoint (host:port). Leave empty to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arena-api
OTEL_TRACES_SAMPLER_ARG=0.1
# Whether to use plaintext (insecure) gRPC for the OTLP exporter.
# true  — acceptable for localhost / sidecar collectors (Jaeger, otel-collector).
# false — required when the OTLP collector is remote; enforces TLS.
# A startup warning is emitted when true with a non-localhost endpoint.
OTEL_EXPORTER_OTLP_INSECURE=true

# ---- Worker ----
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
WORKER_JOB_TIMEOUT=5m
WORKER_RETRY_BACKOFF_BASE=2s
WORKER_RETRY_BACKOFF_MAX=10m
# Internal metrics / healthz listen address for arena-worker sidecar
WORKER_METRICS_ADDR=:9091

# ---- Outbox dispatcher ----
# Delivery mode: noop | webhook | disabled
# noop   — log only (dev/test).
# webhook — POST signed payloads to OUTBOX_WEBHOOK_URL (production).
# disabled — explicitly disable dispatch (production when no consumers).
# Empty value defaults to noop. FORBIDDEN in production: must be explicit.
OUTBOX_MODE=noop
OUTBOX_WEBHOOK_URL=
OUTBOX_SIGNING_SECRET=
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50

# ---- Email delivery ----
# Delivery mode: log | smtp
# log  — write email content to structured logger (dev/test only).
# smtp — deliver via SMTP. Required in production.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- Media storage backend ----
# Backend: s3 | local | (empty = disabled)
MEDIA_BACKEND=
MEDIA_LOCAL_ROOT=
# HMAC key for signing local-backend download URLs.
# Required when MEDIA_BACKEND=local in production (>= 32 bytes).
# In development the JWT secret is used as a fallback if this is empty.
MEDIA_SIGNING_SECRET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_USE_PATH_STYLE=true

# ---- Bil24 compatibility gateway ----
# Set to true to mount /compat/bil24/* routes
BIL24_COMPAT_ENABLED=false
# fid/token credential enforcement for state-mutating gateway commands
# (RESERVATION, UN_RESERVE, SCAN_TICKET). Default true.
# FORBIDDEN to disable in production while BIL24_COMPAT_ENABLED=true:
# validated Config hard-refuses that combination when APP_ENV=production.
BIL24_REQUIRE_TOKEN=true

# ---- Debug / fault-injection (dev/test only) ----
# Mount /v1/debug/* routes (panic trigger, slow endpoint, etc.).
# FORBIDDEN in production: validated Config hard-refuses true when APP_ENV=production.
DEBUG_ROUTES_ENABLED=false
# Simulate a crash after the audit_events write but before outbox_events in /v1/echo.
# Used by atomicity integration tests only.
# FORBIDDEN in production: validated Config hard-refuses true when APP_ENV=production.
FAULT_INJECT_OUTBOX_AFTER_AUDIT=false
