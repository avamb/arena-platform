{
  "name": "@arena/rich-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arena rich-text editor: one Tiptap-based editor library for every interface (spec 44, RT-10).",
  "main": "./dist/rich-editor.js",
  "module": "./dist/rich-editor.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/rich-editor.js"
    },
    "./text": {
      "types": "./dist/types/text.d.ts",
      "import": "./dist/text.js"
    },
    "./rich-editor.css": "./dist/rich-editor.css",
    "./iife": "./dist/arena-rich-editor.iife.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --mode iife && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
