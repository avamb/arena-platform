{{define "subject"}}{{if .LatePayment.Refunding}}Votre paiement pour {{.EventName}} vous est remboursé{{else}}À propos de votre paiement pour {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>À propos de votre paiement</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}Votre paiement vous est remboursé{{else}}Votre paiement est arrivé après la clôture de la commande{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}Vous avez annulé la commande {{.LatePayment.OrderNumber}} pour {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, mais le paiement de {{.LatePayment.Total}} nous est tout de même parvenu.{{else}}Votre paiement de {{.LatePayment.Total}} pour la commande {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) nous est parvenu après la clôture de la commande, et les billets n’ont plus pu vous être réservés.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}Nous remboursons le montant total sur le moyen de paiement utilisé. Votre banque met en général 5 à 10 jours ouvrés à l’afficher.{{else}}L’organisateur vous remboursera le montant total et vous contactera.{{end}}</p>
  <p style="margin:0 0 12px 0;">Aucun billet n’a été émis pour cette commande.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Ticket processing by arenasoldout.com</a><br>{{end}}Si vous cliquez sur « Se désabonner », vous ne recevrez plus les e-mails contenant vos billets ni les e-mails importants concernant votre commande. Nous n’envoyons pas de communications commerciales sans votre consentement.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}

{{if .LatePayment.Refunding}}Votre paiement vous est remboursé{{else}}Votre paiement est arrivé après la clôture de la commande{{end}}

