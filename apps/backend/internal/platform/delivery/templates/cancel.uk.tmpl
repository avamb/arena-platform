{{define "subject"}}{{if .Change.Invitation}}Запрошення скасовано{{else}}Захід скасовано{{end}} — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="uk" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{if .Change.Invitation}}Запрошення скасовано{{else}}Захід скасовано{{end}}</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .Change.Invitation}}Ваше запрошення скасовано{{else}}Ваш захід скасовано{{end}}</h1>
  <p style="margin:0 0 12px 0;">Вітаємо{{with .HolderName}}, {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">{{if .Change.Invitation}}Організатор скасував Ваше запрошення на <strong>{{.EventName}}</strong>{{with .SessionStart}} ({{.}}){{end}}. Ваш квиток більше не дійсний для входу.{{else}}Організатор скасував сеанс заходу <strong>{{.EventName}}</strong>{{with .SessionStart}}, запланований на {{.}}{{end}}. Ваш квиток на цей сеанс більше не дійсний для входу.{{end}}</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    <tr><td><strong>Захід</strong></td><td>{{.EventName}}</td></tr>
    {{with .SessionStart}}<tr><td><strong>Сеанс</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .VenueName}}<tr><td><strong>Місце проведення</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .TierName}}<tr><td><strong>Категорія</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>Сектор</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Ряд</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Місце</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  {{with .Change.MessageHTML}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Повідомлення від організатора:</strong></p>
    <div style="margin:0;font-size:14px;line-height:1.6;">{{.}}</div>
  </div>{{end}}
  {{if or .Change.ContactEmail .Change.ContactFormURL}}<p style="margin:0 0 12px 0;">Напишіть організатору{{with .Change.ContactName}} ({{.}}){{end}} {{if .Change.ContactEmail}}на адресу <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{else if .Change.ContactFormURL}}через <a href="{{.Change.ContactFormURL}}" style="color:#1a73e8">форму на сторінці продажу</a>{{end}}{{with .Change.ContactPhone}}, телефон {{.}}{{end}}, щоб дізнатися про подальші кроки.</p>{{end}}
  <p style="font-size:12px;color:#666">Номер квитка: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">Надіслано на: {{.RecipientEmail}}</p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Контакт: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Контакт: <a href="{{.}}" style="color:#666">Написати організатору</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Обробка квитків: arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Якщо Ви натиснете «Відписатися», листи з Вашими квитками й важливі листи про Ваше замовлення більше не надходитимуть. Маркетингових розсилок без Вашої згоди ми не надсилаємо.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

