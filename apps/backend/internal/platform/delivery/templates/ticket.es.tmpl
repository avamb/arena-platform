{{define "subject"}}{{if gt (len .Tickets) 1}}Tus entradas — {{.EventName}}{{else}}Tu entrada — {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="es" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tu entrada</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:28px 32px 8px 32px;color:#22333D;font-size:16px;">¡Hola{{with .HolderName}}, {{.}}{{end}}!</td></tr>
  <tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">{{if gt (len .Tickets) 1}}Gracias por tu compra. Tus entradas para «{{.EventName}}» están adjuntas a este correo (PDF).{{else}}Gracias por tu compra. Tu entrada para «{{.EventName}}» está adjunta a este correo (PDF).{{end}}</td></tr>
  <tr><td style="padding:8px 32px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-left:4px solid {{.Accent}};background:#f8f9fa;"><tr><td style="padding:12px 16px;color:#22333D;font-size:14px;line-height:1.6;">
      <strong>{{.EventName}}</strong>{{with .SessionStart}}<br>{{.}}{{end}}{{with .VenueName}}<br>{{.}}{{end}}
    </td></tr></table>
  </td></tr>
  <tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">{{if gt (len .Tickets) 1}}Entradas ({{len .Tickets}}){{else}}Entrada{{end}}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;border-collapse:collapse;">
    {{range .Tickets}}<tr><td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;">N.º {{.Number}}{{with .Tier}} · {{.}}{{end}}{{with .Seat}} · {{.}}{{end}}</td>{{with .Price}}<td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td>{{end}}</tr>
    {{else}}<tr><td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;">N.º {{.TicketID}}{{with .TierName}} · {{.}}{{end}}{{with .SeatSector}} · Sector {{.}}{{end}}{{with .SeatRow}} · Fila {{.}}{{end}}{{with .SeatNumber}} · Asiento {{.}}{{end}}</td></tr>
    {{end}}</table>
  </td></tr>
  {{with .Payment}}<tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">Pago</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;border-collapse:collapse;">
      <tr><td style="padding:4px 0;color:#46555f;">Pedido</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">N.º {{.OrderNumber}}</td></tr>
      {{with .PaidAt}}<tr><td style="padding:4px 0;color:#46555f;">Pagado el</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      {{with .Subtotal}}<tr><td style="padding:4px 0;color:#46555f;">Entradas</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      {{with .Discount}}<tr><td style="padding:4px 0;color:#46555f;">Descuento</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">−{{.}}</td></tr>{{end}}
      {{with .ServiceFee}}<tr><td style="padding:4px 0;color:#46555f;">Gastos de gestión</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      <tr><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;">Total pagado</td><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;white-space:nowrap;text-align:right;">{{.Total}}</td></tr>
    </table>
  </td></tr>{{end}}
  <tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">Abre el archivo en el móvil y muestra el código de barras en la entrada — no hace falta imprimirlo.</td></tr>
  <tr><td style="padding:8px 32px 16px 32px;color:#46555f;font-size:14px;line-height:1.6;">Si tienes alguna pregunta, responde a este correo.</td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
    Enviado a: {{.RecipientEmail}}<br><br>
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Contacto: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — entrega automática</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}{{with .Branding.WebsiteURL}} ({{.}}){{end}}

