{{define "subject"}}{{if .LatePayment.Refunding}}אנחנו מחזירים את התשלום עבור {{.EventName}}{{else}}לגבי התשלום שלכם עבור {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="he" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>לגבי התשלום שלכם</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}אנחנו מחזירים את התשלום שלכם{{else}}התשלום הגיע אחרי שההזמנה נסגרה{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}ביטלתם את הזמנה {{.LatePayment.OrderNumber}} עבור {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, אבל התשלום בסך {{.LatePayment.Total}} בכל זאת הגיע אלינו.{{else}}התשלום שלכם בסך {{.LatePayment.Total}} עבור הזמנה {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) הגיע אלינו אחרי שההזמנה נסגרה, ולא ניתן היה לשמור עבורכם את הכרטיסים.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}אנחנו מחזירים את מלוא הסכום לאמצעי התשלום שבו שילמתם. בדרך כלל לבנק לוקח 5–10 ימי עסקים להציג את ההחזר.{{else}}המארגן יחזיר לכם את מלוא הסכום וייצור איתכם קשר.{{end}}</p>
  <p style="margin:0 0 12px 0;">לא הונפקו כרטיסים עבור הזמנה זו.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Ticket processing by arenasoldout.com</a><br>{{end}}אם תלחצו על ״ביטול הרשמה״, לא תקבלו יותר את המיילים עם הכרטיסים שלכם ואת המיילים החשובים על ההזמנה שלכם. אנחנו לא שולחים דיוורים שיווקיים ללא הסכמתכם.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

