{{define "html"}}<!DOCTYPE html>
<html lang="en" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{if eq .Referral.Reversal "disputed"}}A friend opened a dispute{{else}}A friend got money back{{end}}</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  <tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if eq .Referral.Reversal "disputed"}}A friend opened a dispute{{else}}A friend got money back{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if eq .Referral.Reversal "disputed"}}A friend who used code <strong>{{.Referral.Code}}</strong> opened a dispute on order {{.Referral.Order}}. The cashback of {{.Referral.Amount}} has already been paid to the referrer and cannot be taken back.{{else}}A friend who used code <strong>{{.Referral.Code}}</strong> got money back for order {{.Referral.Order}}. The cashback of {{.Referral.Amount}} has already been paid to the referrer and cannot be taken back.{{end}}</p>
  {{if .Referral.CodePaused}}<p style="margin:0 0 12px 0;">The code <strong>{{.Referral.Code}}</strong> is stopped: it gives no new discounts. Payouts already made stay as they are.</p>{{end}}
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">Arena Platform — automated message</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

