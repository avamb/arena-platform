{{define "subject"}}{{if and .Change.Date .Change.Venue}}Event details changed{{else if .Change.Date}}Your event has been rescheduled{{else}}The venue has changed{{end}} — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="en" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your event has changed</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Your event has changed</h1>
  <p style="margin:0 0 12px 0;">Hello{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">The organizer has changed the details of <strong>{{.EventName}}</strong>. Here is what is different.</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;margin-bottom:12px">
    {{if .Change.Date}}{{with .Change.OldStart}}<tr><td><strong>Previous date and time</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewStart}}<tr><td><strong>New date and time</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{if .Change.Venue}}{{with .Change.OldVenue}}<tr><td><strong>Previous venue</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewVenue}}<tr><td><strong>New venue</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
  </table>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    <tr><td><strong>Event</strong></td><td>{{.EventName}}</td></tr>
    {{if not .Change.Date}}{{with .SessionStart}}<tr><td><strong>Session</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .DoorsOpen}}<tr><td><strong>Doors open</strong></td><td>{{.}}</td></tr>{{end}}
    {{if not .Change.Venue}}{{with .VenueName}}<tr><td><strong>Venue</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .TierName}}<tr><td><strong>Tier</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>Sector</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Row</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Seat</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  <p style="margin:0 0 12px 0;">A new ticket PDF with the updated details is attached. Your ticket barcode has not changed — both the old and the new PDF are valid at the entrance.</p>
  {{with .Change.Message}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Message from the organizer:</strong></p>
    <p style="margin:0;white-space:pre-line">{{.}}</p>
  </div>{{end}}
  <p style="margin:0 0 12px 0;">If the change does not suit you, write to the organizer{{with .Change.ContactName}} ({{.}}){{end}} at <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{with .Change.ContactPhone}}, phone {{.}}{{end}}, and describe what you would like to do. The organizer reads every message.</p>
  <p style="font-size:12px;color:#666">Ticket ID: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">Delivered to: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Contact: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — automated message</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

