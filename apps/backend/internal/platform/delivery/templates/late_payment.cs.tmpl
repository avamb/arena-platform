{{define "subject"}}{{if .LatePayment.Refunding}}Vracíme vaši platbu za {{.EventName}}{{else}}K vaší platbě za {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="cs" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>K vaší platbě</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}Vracíme vaši platbu{{else}}Platba přišla po uzavření objednávky{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}Objednávku {{.LatePayment.OrderNumber}} na {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}} jste zrušili, platba {{.LatePayment.Total}} k nám přesto dorazila.{{else}}Vaše platba {{.LatePayment.Total}} za objednávku {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) k nám dorazila až po uzavření objednávky a vstupenky už pro vás nebylo možné podržet.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}Celou částku vracíme na platební prostředek, kterým jste platili. Bance to obvykle trvá 5–10 pracovních dní.{{else}}Organizátor vám celou částku vrátí a ozve se vám.{{end}}</p>
  <p style="margin:0 0 12px 0;">K této objednávce nebyly vydány žádné vstupenky.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Ticket processing by arenasoldout.com</a><br>{{end}}Pokud kliknete na „Odhlásit odběr“, přestanou vám chodit e-maily s vašimi vstupenkami i důležité e-maily o vaší objednávce. Reklamní e-maily bez vašeho souhlasu neposíláme.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}

{{if .LatePayment.Refunding}}Vracíme vaši platbu{{else}}Platba přišla po uzavření objednávky{{end}}

{{if .LatePayment.BuyerCancelled}}Objednávku {{.LatePayment.OrderNumber}} na {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}} jste zrušili, platba {{.LatePayment.Total}} k nám přesto dorazila.{{else}}Vaše platba {{.LatePayment.Total}} za objednávku {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) k nám dorazila až po uzavření objednávky a vstupenky už pro vás nebylo možné podržet.{{end}}
{{if .LatePayment.Refunding}}Celou částku vracíme na platební prostředek, kterým jste platili. Bance to obvykle trvá 5–10 pracovních dní.{{else}}Organizátor vám celou částku vrátí a ozve se vám.{{end}}
K této objednávce nebyly vydány žádné vstupenky.
{{with .LatePayment.Venue}}{{.}}
{{end}}
