{{define "subject"}}{{if .Shop.Pickup}}Bestellung Nr. {{.Shop.OrderNumber}} ist bereit{{else}}Bestellung Nr. {{.Shop.OrderNumber}} wurde versendet{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="de" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{if .Shop.Pickup}}Ihre Bestellung ist bereit{{else}}Ihre Bestellung ist unterwegs{{end}}</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .Shop.Pickup}}Ihre Bestellung ist bereit{{else}}Ihre Bestellung ist unterwegs{{end}}</h1>
  <p style="margin:0 0 12px 0;">Guten Tag{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">{{if .Shop.Pickup}}Die Bestellung <strong>Nr. {{.Shop.OrderNumber}}</strong> liegt zur Abholung bereit.{{else}}Die Bestellung <strong>Nr. {{.Shop.OrderNumber}}</strong> wurde zum Versand übergeben.{{end}}</p>
  {{with .Shop.TrackingNote}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Versanddetails</p><p style="margin:0 0 12px 0;white-space:pre-line;">{{.}}</p>{{end}}
  <p style="margin:0 0 6px 0;font-weight:bold;color:#22333D;">Ihre Bestellung</p>
  <table width="100%" cellpadding="4" style="border-collapse:collapse;font-size:14px;">
    {{range .Shop.Items}}<tr><td>{{.Qty}} × {{.Title}}</td><td style="text-align:right;white-space:nowrap;">{{.LineTotal}}</td></tr>{{end}}
    {{with .Shop.Subtotal}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Waren</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.}}</td></tr>{{end}}
    {{with .Shop.Discount}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Rabatt</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">−{{.}}</td></tr>{{end}}
    {{with .Shop.Shipping}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Versand</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.}}</td></tr>{{end}}
    <tr><td style="border-top:1px solid #eceff1;"><strong>Gesamt bezahlt</strong></td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;"><strong>{{.Shop.Total}}</strong></td></tr>
  </table>
  {{if .Shop.Pickup}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Abholung</p><p style="margin:0 0 12px 0;">Sie haben die Abholung gewählt.</p>{{else if .Shop.Address}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Lieferadresse</p><p style="margin:0 0 12px 0;">{{range $i, $l := .Shop.Address}}{{if $i}}<br>{{end}}{{$l}}{{end}}</p>{{end}}
  {{with .Shop.Note}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Ihre Anmerkung</p><p style="margin:0 0 12px 0;white-space:pre-line;">{{.}}</p>{{end}}
  {{with .Shop.StatusURL}}<p style="margin:16px 0 12px 0;"><a href="{{.}}" style="color:{{$.Accent}};font-weight:bold;">Bestellstatus ansehen</a></p>{{end}}
  {{if .Branding.ContactEmail}}<p style="margin:0 0 12px 0;">Fragen? Antworten Sie auf diese E-Mail.</p>{{end}}
  <p style="font-size:12px;color:#666">Zugestellt an: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakt: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kontakt: <a href="{{.}}" style="color:#666">Dem Veranstalter schreiben</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — automatische Nachricht</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Wenn Sie auf „Abbestellen“ klicken, erhalten Sie keine E-Mails zu Ihren Bestellungen mehr. Werbe-Mailings senden wir nicht ohne Ihre Einwilligung.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

