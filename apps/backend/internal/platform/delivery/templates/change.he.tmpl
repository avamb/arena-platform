{{define "subject"}}{{if and .Change.Date .Change.Venue}}פרטי האירוע שונו{{else if .Change.Date}}מועד האירוע שונה{{else}}מקום האירוע שונה{{end}} — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="he" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>האירוע שלך השתנה</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" dir="rtl" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;text-align:right;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">האירוע שלך השתנה</h1>
  <p style="margin:0 0 12px 0;">שלום{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">המארגן שינה את פרטי האירוע <strong>{{.EventName}}</strong>. אלה השינויים:</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;direction:rtl;margin-bottom:12px">
    {{if .Change.Date}}{{with .Change.OldStart}}<tr><td><strong>מועד קודם</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewStart}}<tr><td><strong>מועד חדש</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{if .Change.Venue}}{{with .Change.OldVenue}}<tr><td><strong>מקום קודם</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewVenue}}<tr><td><strong>מקום חדש</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
  </table>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;direction:rtl">
    <tr><td><strong>אירוע</strong></td><td>{{.EventName}}</td></tr>
    {{if not .Change.Date}}{{with .SessionStart}}<tr><td><strong>מועד</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .DoorsOpen}}<tr><td><strong>פתיחת דלתות</strong></td><td><span dir="ltr">{{.}}</span></td></tr>{{end}}
    {{if not .Change.Venue}}{{with .VenueName}}<tr><td><strong>מקום</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .TierName}}<tr><td><strong>קטגוריה</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>אזור</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>שורה</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>מקום</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  <p style="margin:0 0 12px 0;">קובץ PDF חדש של הכרטיס עם הפרטים המעודכנים מצורף להודעה. הברקוד של הכרטיס שלך לא השתנה — בכניסה תקפים גם ה-PDF הישן וגם החדש.</p>
  {{with .Change.Message}}<div style="margin:16px 0;padding:12px 16px;border-right:3px solid #1a73e8;background:#f5f7fa;direction:rtl;text-align:right">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>הודעה מהמארגן:</strong></p>
    <p style="margin:0;white-space:pre-line">{{.}}</p>
  </div>{{end}}
  <p style="margin:0 0 12px 0;">אם השינוי אינו מתאים לך, כתבו למארגן{{with .Change.ContactName}} ({{.}}){{end}} בכתובת <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{with .Change.ContactPhone}}, טלפון {{.}}{{end}}, וספרו מה הייתם רוצים לעשות. המארגן קורא כל הודעה.</p>
  <p style="font-size:12px;color:#666">מזהה כרטיס: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">נשלח אל: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;text-align:right;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>יצירת קשר: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — שליחה אוטומטית</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

