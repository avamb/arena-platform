{{define "subject"}}{{with .Reissue}}Jūsu jaunās biļetes — {{$.EventName}}{{else}}{{if gt (len .Tickets) 1}}Jūsu biļetes — {{.EventName}}{{else}}Jūsu biļete — {{.EventName}}{{end}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="lv" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Jūsu biļete</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:28px 32px 8px 32px;color:#22333D;font-size:16px;">Labdien{{with .HolderName}} {{.}}{{end}}!</td></tr>
  <tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">{{with .Reissue}}{{if .Typo}}Pirkuma brīdī norādītajā e-pasta adresē bija drukas kļūda, tāpēc pirmā vēstule ar jūsu biļetēm nonāca citā adresē. Jūs sazinājāties ar organizatoru un apstiprinājāt savus datus. Mēs esam izsnieguši jaunas biļetes, tās ir pielikumā.<br><br>Biļetes no pirmās vēstules vairs nav derīgas. Ieeja būs tikai ar jaunajām biļetēm.{{else}}Pēc jūsu pieprasījuma mēs esam izsnieguši jaunas biļetes iepriekšējo vietā. Tās ir pielikumā.<br><br>Iepriekšējās biļetes vairs nav derīgas. Ieeja būs tikai ar jaunajām biļetēm.{{end}}<br><br>Jūsu vietas un maksājums nav mainījušies.{{with .OrderNumber}} Pasūtījuma numurs: {{.}}.{{end}}{{else}}{{if gt (len .Tickets) 1}}Paldies par pirkumu. Jūsu biļetes uz pasākumu “{{.EventName}}” ir pievienotas šim e-pasta ziņojumam (PDF faili).{{else}}Paldies par pirkumu. Jūsu biļete uz pasākumu “{{.EventName}}” ir pievienota šim e-pasta ziņojumam (PDF).{{end}}{{end}}</td></tr>
  <tr><td style="padding:8px 32px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-left:4px solid {{.Accent}};background:#f8f9fa;"><tr><td style="padding:12px 16px;color:#22333D;font-size:14px;line-height:1.6;">
      <strong>{{.EventName}}</strong>{{with .SessionStart}}<br>{{.}}{{end}}{{with .DoorsOpen}}<br>Durvis atver {{.}}{{end}}{{with .VenueName}}<br>{{.}}{{end}}{{with .Directions.GoogleURL}}<br>Norādes: <a href="{{.}}" style="color:{{$.Accent}};">Google Maps</a> · <a href="{{$.Directions.WazeURL}}" style="color:{{$.Accent}};">Waze</a>{{end}}
    </td></tr></table>
  </td></tr>
  <tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">{{if gt (len .Tickets) 1}}Biļetes ({{len .Tickets}}){{else}}Biļete{{end}}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;border-collapse:collapse;">
    {{range .Tickets}}<tr><td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;">Nr. {{.Number}}{{with .Tier}} · {{.}}{{end}}{{with .Seat}} · {{.}}{{end}}{{with .DownloadURL}}<br><a href="{{.}}" style="color:{{$.Accent}};font-size:13px;">Lejupielādēt PDF</a>{{end}}</td>{{with .Price}}<td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td>{{end}}</tr>
    {{else}}<tr><td style="padding:7px 0;border-bottom:1px solid #eceff1;color:#22333D;">Nr. {{.TicketID}}{{with .TierName}} · {{.}}{{end}}{{with .SeatSector}} · Sektors {{.}}{{end}}{{with .SeatRow}} · Rinda {{.}}{{end}}{{with .SeatNumber}} · Vieta {{.}}{{end}}</td></tr>
    {{end}}</table>
  </td></tr>
  {{with .Payment}}<tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">Maksājums</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;border-collapse:collapse;">
      <tr><td style="padding:4px 0;color:#46555f;">Pasūtījums</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">Nr. {{.OrderNumber}}</td></tr>
      {{with .PaidAt}}<tr><td style="padding:4px 0;color:#46555f;">Apmaksāts</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      {{with .Subtotal}}<tr><td style="padding:4px 0;color:#46555f;">Biļetes</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      {{with .Discount}}<tr><td style="padding:4px 0;color:#46555f;">Atlaide</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">−{{.}}</td></tr>{{end}}
      {{with .ServiceFee}}<tr><td style="padding:4px 0;color:#46555f;">Pakalpojuma maksa</td><td style="padding:4px 0;color:#22333D;white-space:nowrap;text-align:right;">{{.}}</td></tr>{{end}}
      <tr><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;">Kopā apmaksāts</td><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;white-space:nowrap;text-align:right;">{{.Total}}</td></tr>
    </table>
  </td></tr>{{end}}
  {{with .EventNote.HTML}}<tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">Par pasākumu</div>
    <div style="color:#46555f;font-size:14px;line-height:1.6;">{{.}}</div>
  </td></tr>{{end}}
  {{if .WithdrawalNotice}}<tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">Uz biļetēm uz pasākumu konkrētā datumā atteikuma tiesības neattiecas. Pasūtījums kļuva saistošs brīdī, kad jūs to apmaksājāt.</td></tr>{{end}}
  <tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">Atveriet failu telefonā un uzrādiet svītrkodu ieejā — drukāt nav nepieciešams.</td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
    Nosūtīts uz: {{.RecipientEmail}}<br><br>
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakti: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kontakti: <a href="{{.}}" style="color:#666">Rakstīt organizatoram</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Biļešu apstrādi nodrošina arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Ja noklikšķināsiet uz “Atteikties no abonēšanas”, jūs vairs nesaņemsiet e-pastus ar biļetēm un svarīgus e-pastus par pasūtījumu. Mēs nesūtām mārketinga ziņojumus bez jūsu piekrišanas.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

