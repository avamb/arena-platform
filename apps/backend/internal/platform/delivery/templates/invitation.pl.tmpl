{{define "subject"}}{{with .Reissue}}Nowe zaproszenie — {{$.EventName}}{{else}}Zaproszenie — {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="pl" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Zaproszenie</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Zapraszamy na wydarzenie</h1>
  <p style="margin:0 0 12px 0;">Dzień dobry{{with .HolderName}} {{.}}{{end}},</p>
{{with .Reissue}}<p style="margin:0 0 12px 0;">{{if .Typo}}W Państwa adresie e-mail była literówka, dlatego pierwsza wiadomość z zaproszeniem trafiła na inny adres. Skontaktowali się Państwo z organizatorem i potwierdzili swoje dane. Wystawiliśmy dla Państwa nowe zaproszenie.<br><br>Zaproszenie z pierwszej wiadomości przestało być ważne. Wejście umożliwia tylko nowe zaproszenie.{{else}}Na Państwa prośbę wystawiliśmy nowe zaproszenie w miejsce poprzedniego.<br><br>Poprzednie zaproszenie przestało być ważne. Wejście umożliwia tylko nowe zaproszenie.{{end}}</p>
{{end}}  <p style="margin:0 0 12px 0;">Wystawiliśmy dla Państwa bezpłatny bilet zaproszeniowy na wydarzenie
     <strong>{{.EventName}}</strong>. Plik PDF jest w załączniku.</p>
  <p style="margin:0 0 12px 0;">Ten bilet jest bezpłatnym zaproszeniem — nie wymaga żadnej płatności.</p>
  {{with .Directions.GoogleURL}}<p style="margin:0 0 12px 0;">{{with $.VenueName}}{{.}}<br>{{end}}Dojazd: <a href="{{.}}" style="color:{{$.Accent}};">Google Maps</a> · <a href="{{$.Directions.WazeURL}}" style="color:{{$.Accent}};">Waze</a></p>{{end}}
  {{if gt (len .Tickets) 1}}<table cellpadding="4" style="border-collapse:collapse;font-size:14px">{{range .Tickets}}<tr><td>Nr {{.Number}}{{with .Tier}} · {{.}}{{end}}{{with .Seat}} · {{.}}{{end}}</td></tr>{{end}}</table>{{else if or .SeatSector .SeatRow .SeatNumber}}<table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    {{with .SeatSector}}<tr><td><strong>Sektor</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Rząd</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Miejsce</strong></td><td>{{.}}</td></tr>{{end}}
  </table>{{end}}
  {{if le (len .Tickets) 1}}<p style="font-size:12px;color:#666">Numer biletu: {{.TicketID}}</p>{{end}}
  <p style="font-size:12px;color:#666">Wiadomość wysłano na adres: {{.RecipientEmail}}</p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakt: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kontakt: <a href="{{.}}" style="color:#666">Napisz do organizatora</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Obsługa biletów: arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Jeśli klikną Państwo „Wypisz się”, wiadomości z biletami oraz ważne wiadomości o zamówieniu przestaną do Państwa docierać. Nie wysyłamy wiadomości marketingowych bez Państwa zgody.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

