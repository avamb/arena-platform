{{define "subject"}}{{if .Shop.Pickup}}Order No. {{.Shop.OrderNumber}} is ready{{else}}Order No. {{.Shop.OrderNumber}} has been shipped{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="en" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{if .Shop.Pickup}}Your order is ready{{else}}Your order is on its way{{end}}</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .Shop.Pickup}}Your order is ready{{else}}Your order is on its way{{end}}</h1>
  <p style="margin:0 0 12px 0;">Hello{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">{{if .Shop.Pickup}}Order <strong>No. {{.Shop.OrderNumber}}</strong> is ready for pickup.{{else}}Order <strong>No. {{.Shop.OrderNumber}}</strong> has been handed over for delivery.{{end}}</p>
  {{with .Shop.TrackingNote}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Shipping details</p><p style="margin:0 0 12px 0;white-space:pre-line;">{{.}}</p>{{end}}
  <p style="margin:0 0 6px 0;font-weight:bold;color:#22333D;">Your order</p>
  <table width="100%" cellpadding="4" style="border-collapse:collapse;font-size:14px;">
    {{range .Shop.Items}}<tr><td>{{.Qty}} × {{.Title}}</td><td style="text-align:right;white-space:nowrap;">{{.LineTotal}}</td></tr>{{end}}
    {{with .Shop.Subtotal}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Goods</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.}}</td></tr>{{end}}
    {{with .Shop.Discount}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Discount</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">−{{.}}</td></tr>{{end}}
    {{with .Shop.Shipping}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Shipping</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.}}</td></tr>{{end}}
    <tr><td style="border-top:1px solid #eceff1;"><strong>Total paid</strong></td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;"><strong>{{.Shop.Total}}</strong></td></tr>
  </table>
  {{if .Shop.Pickup}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Pickup</p><p style="margin:0 0 12px 0;">You chose to pick up your order.</p>{{else if .Shop.Address}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Delivery address</p><p style="margin:0 0 12px 0;">{{range $i, $l := .Shop.Address}}{{if $i}}<br>{{end}}{{$l}}{{end}}</p>{{end}}
  {{with .Shop.Note}}<p style="margin:16px 0 6px 0;font-weight:bold;color:#22333D;">Your note</p><p style="margin:0 0 12px 0;white-space:pre-line;">{{.}}</p>{{end}}
  {{with .Shop.StatusURL}}<p style="margin:16px 0 12px 0;"><a href="{{.}}" style="color:{{$.Accent}};font-weight:bold;">Check the status of your order</a></p>{{end}}
  {{if .Branding.ContactEmail}}<p style="margin:0 0 12px 0;">Questions? Reply to this e-mail.</p>{{end}}
  <p style="font-size:12px;color:#666">Delivered to: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Contact: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Contact: <a href="{{.}}" style="color:#666">Write to the organizer</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — automated message</p>
  <p style="font-size:11px;color:#999;line-height:1.5">If you click “Unsubscribe”, the letters about your orders will no longer reach you. We do not send marketing mailings without your consent.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

