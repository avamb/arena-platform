  <p style="margin:0 0 12px 0;"><strong>{{.EventName}}</strong></p>
  <p style="margin:0 0 12px 0;">Séance : <strong>{{.SalesAlert.When}}</strong>{{with .SalesAlert.Venue}}<br>Lieu : {{.}}{{end}}</p>
