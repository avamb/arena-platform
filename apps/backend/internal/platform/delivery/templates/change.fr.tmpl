{{define "subject"}}{{if and .Change.Date .Change.Venue}}Modification des informations de l'événement{{else if .Change.Date}}Votre événement a été reporté{{else}}Le lieu a changé{{end}} — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Votre événement a changé</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Votre événement a changé</h1>
  <p style="margin:0 0 12px 0;">Bonjour{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">L'organisateur a modifié les informations de <strong>{{.EventName}}</strong>. Voici ce qui change :</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;margin-bottom:12px">
    {{if .Change.Date}}{{with .Change.OldStart}}<tr><td><strong>Ancienne date et heure</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewStart}}<tr><td><strong>Nouvelle date et heure</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{if .Change.Venue}}{{with .Change.OldVenue}}<tr><td><strong>Ancien lieu</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewVenue}}<tr><td><strong>Nouveau lieu</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
  </table>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    <tr><td><strong>Événement</strong></td><td>{{.EventName}}</td></tr>
    {{if not .Change.Date}}{{with .SessionStart}}<tr><td><strong>Séance</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .DoorsOpen}}<tr><td><strong>Ouverture des portes</strong></td><td>{{.}}</td></tr>{{end}}
    {{if not .Change.Venue}}{{with .VenueName}}<tr><td><strong>Lieu</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .TierName}}<tr><td><strong>Catégorie</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>Secteur</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Rang</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Place</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  <p style="margin:0 0 12px 0;">Un nouveau PDF de votre billet avec les informations à jour est joint. Le code-barres de votre billet n'a pas changé : l'ancien comme le nouveau PDF sont valables à l'entrée.</p>
  {{with .Change.Message}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Message de l'organisateur :</strong></p>
    <p style="margin:0;white-space:pre-line">{{.}}</p>
  </div>{{end}}
  {{with .EventNote.Paragraphs}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa;">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>À propos de l’événement:</strong></p>
    {{range .}}<p style="margin:0 0 8px 0;color:#46555f;font-size:14px;line-height:1.6;white-space:pre-line;">{{range .}}{{if .URL}}<a href="{{.URL}}" rel="noopener" style="color:#1a73e8;">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}</p>{{end}}
  </div>{{end}}
  {{if or .Change.ContactEmail .Change.ContactFormURL}}<p style="margin:0 0 12px 0;">Si ce changement ne vous convient pas, écrivez à l'organisateur{{with .Change.ContactName}} ({{.}}){{end}} {{if .Change.ContactEmail}}à l'adresse <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{else if .Change.ContactFormURL}}via le <a href="{{.Change.ContactFormURL}}" style="color:#1a73e8">formulaire de la page de vente</a>{{end}}{{with .Change.ContactPhone}}, téléphone {{.}}{{end}}, et expliquez ce que vous souhaitez faire. L'organisateur lit chaque message.</p>{{end}}
  <p style="font-size:12px;color:#666">Identifiant du billet : {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">Envoyé à : {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Contact : <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Contact : <a href="{{.}}" style="color:#666">Écrire à l'organisateur</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — envoi automatique</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Si vous cliquez sur « Se désabonner », vous ne recevrez plus les e-mails contenant vos billets ni les e-mails importants concernant votre commande. Nous n’envoyons pas de communications commerciales sans votre consentement.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

