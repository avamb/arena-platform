{{define "subject"}}{{if .LatePayment.Refunding}}A(z) {{.EventName}} eseményre fizetett összeget visszautaljuk{{else}}A(z) {{.EventName}} eseményre történt fizetéséről{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="hu" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>A fizetéséről</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}A fizetett összeget visszautaljuk{{else}}A fizetése a rendelés lezárása után érkezett meg{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}Lemondta a(z) {{.LatePayment.OrderNumber}} rendelést a(z) {{.EventName}} eseményre{{with .LatePayment.When}} ({{.}}){{end}}, de a(z) {{.LatePayment.Total}} összegű fizetés mégis megérkezett hozzánk.{{else}}A(z) {{.LatePayment.OrderNumber}} rendelésre ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) fizetett {{.LatePayment.Total}} a rendelés lezárása után érkezett meg hozzánk, és a jegyeket már nem tudtuk megtartani Önnek.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}A teljes összeget visszautaljuk arra a fizetési módra, amellyel fizetett. A bankja ezt általában 5–10 munkanap alatt jeleníti meg.{{else}}A szervező visszatéríti Önnek a teljes összeget, és ez ügyben felveszi Önnel a kapcsolatot.{{end}}</p>
  <p style="margin:0 0 12px 0;">Erre a rendelésre nem állítottunk ki jegyet.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Jegykezelés: arenasoldout.com</a><br>{{end}}Ha a „Leiratkozás” gombra kattint, a jegyeit tartalmazó levelek és a rendeléséről szóló fontos levelek többé nem érkeznek meg Önhöz. Az Ön hozzájárulása nélkül nem küldünk marketinglevelet.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

