{{define "subject"}}הוזמנת — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="he" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>הוזמנת</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" dir="rtl" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;text-align:right;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">הוזמנת!</h1>
  <p style="margin:0 0 12px 0;">שלום{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">הונפקה עבורך הזמנה לכרטיס חינם עבור
     <strong>{{.EventName}}</strong>. קובץ ה-PDF מצורף להודעה זו.</p>
  <p style="margin:0 0 12px 0;">זוהי הזמנה אישית — אין צורך בתשלום.</p>
  {{if or .SeatSector .SeatRow .SeatNumber}}<table cellpadding="4" style="border-collapse:collapse;font-size:14px;direction:rtl">
    {{with .SeatSector}}<tr><td><strong>אזור</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>שורה</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>מקום</strong></td><td>{{.}}</td></tr>{{end}}
  </table>{{end}}
  <p style="font-size:12px;color:#666">מזהה כרטיס: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">נשלח אל: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;text-align:right;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>יצירת קשר: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — שליחת הזמנות אוטומטית</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}{{with .Branding.WebsiteURL}} ({{.}}){{end}}

הוזמנת!

שלום{{with .HolderName}} {{.}}{{end}},

הונפקה עבורך הזמנה לכרטיס חינם עבור {{.EventName}}.
קובץ ה-PDF מצורף להודעה זו.

זוהי הזמנה אישית — אין צורך בתשלום.

{{with .SeatSector}}אזור: {{.}}
{{end}}{{with .SeatRow}}שורה: {{.}}
{{end}}{{with .SeatNumber}}מקום: {{.}}
{{end}}מזהה כרטיס: {{.TicketID}}
נשלח אל: {{.RecipientEmail}}

--
{{.Branding.LegalName}}
{{with .Branding.LegalAddressLine1}}{{.}}
{{end}}{{with .Branding.LegalAddressLine2}}{{.}}
{{end}}{{with .Branding.LegalAddressPostalCode}}{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}
{{else}}{{with .Branding.LegalAddressCity}}{{.}}
{{end}}{{end}}{{with .Branding.LegalAddressCountry}}{{.}}
{{end}}{{with .Branding.ContactEmail}}יצירת קשר: {{.}}
{{end}}
Arena Platform — שליחת הזמנות אוטומטית
{{end}}
