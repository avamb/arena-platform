{{define "subject"}}{{if .LatePayment.Refunding}}Te devolvemos el pago de {{.EventName}}{{else}}Sobre tu pago de {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="es" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sobre tu pago</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}Te devolvemos el pago{{else}}Tu pago llegó después de cerrarse el pedido{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}Cancelaste el pedido {{.LatePayment.OrderNumber}} de {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, pero el pago de {{.LatePayment.Total}} nos llegó de todos modos.{{else}}Tu pago de {{.LatePayment.Total}} del pedido {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) nos llegó después de cerrarse el pedido, y ya no pudimos guardarte las entradas.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}Te devolvemos el importe completo al mismo medio de pago que usaste. Tu banco suele tardar entre 5 y 10 días hábiles en mostrarlo.{{else}}El organizador te devolverá el importe completo y se pondrá en contacto contigo.{{end}}</p>
  <p style="margin:0 0 12px 0;">No se emitieron entradas para este pedido.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Ticket processing by arenasoldout.com</a><br>{{end}}Si pulsas «Cancelar suscripción», dejarás de recibir los correos con tus entradas y los correos importantes sobre tu pedido. No enviamos correos publicitarios sin tu consentimiento.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}

{{if .LatePayment.Refunding}}Te devolvemos el pago{{else}}Tu pago llegó después de cerrarse el pedido{{end}}

{{if .LatePayment.BuyerCancelled}}Cancelaste el pedido {{.LatePayment.OrderNumber}} de {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, pero el pago de {{.LatePayment.Total}} nos llegó de todos modos.{{else}}Tu pago de {{.LatePayment.Total}} del pedido {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) nos llegó después de cerrarse el pedido, y ya no pudimos guardarte las entradas.{{end}}
{{if .LatePayment.Refunding}}Te devolvemos el importe completo al mismo medio de pago que usaste. Tu banco suele tardar entre 5 y 10 días hábiles en mostrarlo.{{else}}El organizador te devolverá el importe completo y se pondrá en contacto contigo.{{end}}
No se emitieron entradas para este pedido.
