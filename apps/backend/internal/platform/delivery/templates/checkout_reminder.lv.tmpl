{{define "subject"}}Jūsu pasūtījums gaida apmaksu: {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="lv" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Jūsu biļetes gaida</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Jūsu biļetes gaida</h1>
  <p style="margin:0 0 12px 0;">Jūs sākāt pasūtījumu uz {{.EventName}} ({{.CartReminder.When}}), taču maksājums vēl nav pabeigts.</p>
  <p style="margin:0 0 12px 0;">Mēs paturam jūsu biļetes līdz {{.CartReminder.HoldUntil}}. Pēc tam tās atkal nonāk pārdošanā.</p>
  <p style="margin:0 0 12px 0;">Pasūtījums {{.CartReminder.OrderNumber}} · Biļetes: {{.CartReminder.Tickets}} · Kopā: {{.CartReminder.Total}}</p>
  {{with .CartReminder.Venue}}<p style="margin:0 0 12px 0;">Norises vieta: {{.}}</p>{{end}}
  <p style="margin:16px 0 16px 0;"><a href="{{.CartReminder.URL}}" style="display:inline-block;background:{{.Accent}};color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 22px;border-radius:6px;">Turpināt uz maksājumu</a></p>
  <p style="margin:0 0 12px 0;"><span style="color:#93a0a8;font-size:12px;word-break:break-all;">Saite: {{.CartReminder.URL}}</span></p>
  <p style="margin:0 0 12px 0;">Ja jūs nevēlaties šīs biļetes, nedariet neko: rezervācija beigsies pati. Šis ir vienīgais atgādinājums par šo pasūtījumu.</p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Biļešu apstrādi nodrošina arenasoldout.com</a><br>{{end}}Ja noklikšķināsiet uz “Atteikties no abonēšanas”, jūs vairs nesaņemsiet e-pastus ar biļetēm un svarīgus e-pastus par pasūtījumu. Mēs nesūtām mārketinga ziņojumus bez jūsu piekrišanas.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

