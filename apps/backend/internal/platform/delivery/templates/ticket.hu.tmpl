      <tr><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;">Összesen kifizetve</td><td style="padding:8px 0 4px 0;border-top:1px solid #dfe3e6;color:#22333D;font-weight:bold;white-space:nowrap;text-align:right;">{{.Total}}</td></tr>
    </table>
  </td></tr>{{end}}
  {{with .EventNote.HTML}}<tr><td style="padding:8px 32px;">
    <div style="font-size:12px;color:#93a0a8;text-transform:uppercase;letter-spacing:0.04em;padding-bottom:4px;">Az eseményről</div>
    <div style="color:#46555f;font-size:14px;line-height:1.6;">{{.}}</div>
  </td></tr>{{end}}
  {{if .WithdrawalNotice}}<tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">Az adott időpontra szóló eseményre váltott jegyekre nem vonatkozik az elállási jog. A rendelés a kifizetéssel vált kötelező érvényűvé.</td></tr>{{end}}
  <tr><td style="padding:8px 32px;color:#46555f;font-size:14px;line-height:1.6;">Nyissa meg a fájlt a telefonján, és a bejáratnál mutassa meg a vonalkódot — nyomtatni nem kell.</td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
    Címzett: {{.RecipientEmail}}<br><br>
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kapcsolat: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kapcsolat: <a href="{{.}}" style="color:#666">Írjon a szervezőnek</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Jegykezelés: arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Ha a „Leiratkozás” gombra kattint, a jegyeit tartalmazó levelek és a rendeléséről szóló fontos levelek többé nem érkeznek meg Önhöz. Az Ön hozzájárulása nélkül nem küldünk marketinglevelet.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

