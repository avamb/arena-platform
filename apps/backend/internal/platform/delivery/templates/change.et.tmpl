{{define "subject"}}{{if and .Change.Date .Change.Venue}}Ürituse andmed on muutunud{{else if .Change.Date}}Teie üritus on ära viidud{{else}}Toimumiskoht on muutunud{{end}} — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="et" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Teie üritus on muutunud</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Teie üritus on muutunud</h1>
  <p style="margin:0 0 12px 0;">Tere{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">Korraldaja on muutnud ürituse <strong>{{.EventName}}</strong> andmeid. Siin on, mis on teisiti.</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;margin-bottom:12px">
    {{if .Change.Date}}{{with .Change.OldStart}}<tr><td><strong>Varasem kuupäev ja kellaaeg</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewStart}}<tr><td><strong>Uus kuupäev ja kellaaeg</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{if .Change.Venue}}{{with .Change.OldVenue}}<tr><td><strong>Varasem toimumiskoht</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .Change.NewVenue}}<tr><td><strong>Uus toimumiskoht</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
  </table>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    <tr><td><strong>Üritus</strong></td><td>{{.EventName}}</td></tr>
    {{if not .Change.Date}}{{with .SessionStart}}<tr><td><strong>Toimumisaeg</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .DoorsOpen}}<tr><td><strong>Uksed avatakse</strong></td><td>{{.}}</td></tr>{{end}}
    {{if not .Change.Venue}}{{with .VenueName}}<tr><td><strong>Toimumiskoht</strong></td><td>{{.}}</td></tr>{{end}}{{end}}
    {{with .Directions.GoogleURL}}<tr><td><strong>Teekond</strong></td><td><a href="{{.}}" style="color:{{$.Accent}};">Google Maps</a> · <a href="{{$.Directions.WazeURL}}" style="color:{{$.Accent}};">Waze</a></td></tr>{{end}}
    {{with .TierName}}<tr><td><strong>Kategooria</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>Sektor</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Rida</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Koht</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  <p style="margin:0 0 12px 0;">Uuendatud andmetega pileti PDF on lisatud. Teie pileti vöötkood ei ole muutunud — sissepääsul kehtivad nii vana kui ka uus PDF.</p>
  {{with .Change.MessageHTML}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Korraldaja sõnum:</strong></p>
    <div style="margin:0;font-size:14px;line-height:1.6;">{{.}}</div>
  </div>{{end}}
  {{with .EventNote.HTML}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa;">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Ürituse kohta:</strong></p>
    <div style="color:#46555f;font-size:14px;line-height:1.6;">{{.}}</div>
  </div>{{end}}
  {{if or .Change.ContactEmail .Change.ContactFormURL}}<p style="margin:0 0 12px 0;">Kui muudatus teile ei sobi, kirjutage korraldajale{{with .Change.ContactName}} ({{.}}){{end}} {{if .Change.ContactEmail}}aadressil <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{else if .Change.ContactFormURL}}müügilehel oleva <a href="{{.Change.ContactFormURL}}" style="color:#1a73e8">vormi kaudu</a>{{end}}{{with .Change.ContactPhone}}, telefon {{.}}{{end}} ning kirjeldage, mida soovite teha. Korraldaja loeb iga sõnumi läbi.</p>{{end}}
  <p style="font-size:12px;color:#666">Pileti ID: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">Saadetud aadressile: {{.RecipientEmail}}</p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakt: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kontakt: <a href="{{.}}" style="color:#666">Kirjutage korraldajale</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Piletite töötlemine: arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Kui vajutate „Tellimus lõpetada“, ei jõua teieni enam piletitega kirjad ega olulised kirjad teie tellimuse kohta. Turundusuudiskirju me ilma teie nõusolekuta ei saada.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

