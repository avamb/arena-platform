{{define "subject"}}אשרו את ההרשמה לדיוור של {{.Branding.OrgName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="he" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>אשרו את ההרשמה</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">אשרו את ההרשמה</h1>
  <p style="margin:0 0 12px 0;">{{if .Marketing.FromSite}}נרשמתם באתר לקבלת עדכונים על אירועים והצעות מ־{{.Branding.OrgName}}. אשרו שזו הכתובת שלכם:{{else}}בזמן ההזמנה הסכמתם לקבל מ־{{.Branding.OrgName}} עדכונים על אירועים והצעות במייל. אשרו שזו הכתובת שלכם:{{end}}</p>
  <p style="margin:16px 0 16px 0;"><a href="{{.Marketing.ConfirmURL}}" style="display:inline-block;background:{{.Accent}};color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 22px;border-radius:6px;">לאישור ההרשמה</a></p>
  <p style="margin:0 0 12px 0;"><span style="color:#93a0a8;font-size:12px;word-break:break-all;">קישור: {{.Marketing.ConfirmURL}}</span></p>
  <p style="margin:0 0 12px 0;">אם לא ביקשתם זאת, אל תעשו דבר: לא תקבלו דיוורים. הקישור תקף 7 ימים.</p>
  <p style="margin:0 0 12px 0;">שיניתם את דעתכם? אפשר להפסיק את הדיוור בכל עת: <a href="{{.Marketing.WithdrawURL}}" style="color:#46555f;">להפסקת הדיוור</a></p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Ticket processing by arenasoldout.com</a><br>{{end}}אם תלחצו על ״ביטול הרשמה״, המיילים שלנו לא יגיעו יותר לעולם לכתובת הזאת, גם לא כרטיסים.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}

אשרו את ההרשמה

