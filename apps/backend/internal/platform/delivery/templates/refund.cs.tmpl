{{define "subject"}}Vrácení peněz za vstupenky — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="cs" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vaše platba se vrací</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Vaše platba se vrací</h1>
  <p style="margin:0 0 12px 0;">Dobrý den{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">Odeslali jsme vám vrácení <strong>{{.Refund.Total}}</strong> za vstupenky na <strong>{{.EventName}}</strong>{{with .SessionStart}} ({{.}}){{end}}.</p>
  <p style="margin:0 0 6px 0;font-weight:bold;color:#22333D;">Vrácené vstupenky</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;">
    {{range .Tickets}}<tr><td>Vstupenka {{.Number}}{{with .Tier}} · {{.}}{{end}}{{with .Seat}} · {{.}}{{end}}{{if .Void}} · <strong>již neplatí</strong>{{end}}</td><td style="text-align:right;">{{.Price}}</td></tr>{{end}}
    <tr><td style="border-top:1px solid #eceff1;"><strong>Celkem vráceno</strong></td><td style="border-top:1px solid #eceff1;text-align:right;"><strong>{{.Refund.Total}}</strong></td></tr>
  </table>
  <p style="margin:16px 0 12px 0;">Peníze se vrátí na platební metodu, kterou jste platili. Bance obvykle trvá 5–10 pracovních dnů, než je zobrazí.</p>
  {{if .Refund.TicketsCancelled}}<p style="margin:0 0 12px 0;">Vrácené vstupenky již neplatí pro vstup.</p>{{else if .Refund.SomeTicketsCancelled}}<p style="margin:0 0 12px 0;">Pro vstup již nelze použít pouze vstupenky označené „již neplatí“; ostatní vstupenky v seznamu výše zůstávají platné.</p>{{end}}
  <p style="margin:0 0 12px 0;">Máte dotazy? Odpovězte na tento e-mail.</p>
  <p style="font-size:12px;color:#666">Doručeno na: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakt: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kontakt: <a href="{{.}}" style="color:#666">Napsat pořadateli</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — automatická zpráva</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}{{with .Branding.WebsiteURL}} ({{.}}){{end}}

Vaše platba se vrací

Dobrý den{{with .HolderName}} {{.}}{{end}},

