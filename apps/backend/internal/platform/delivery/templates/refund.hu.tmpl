{{define "subject"}}Jegyeinek visszatérítése — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="hu" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>A visszatérítés úton van</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">A visszatérítés úton van</h1>
  <p style="margin:0 0 12px 0;">Üdvözöljük{{with .HolderName}}, {{.}}{{end}}!</p>
  <p style="margin:0 0 12px 0;">Visszatérítettük <strong>{{.Refund.Total}}</strong> összeget a(z) <strong>{{.EventName}}</strong>{{with .SessionStart}} ({{.}}){{end}} eseményre szóló jegyeiért.</p>
  <p style="margin:0 0 6px 0;font-weight:bold;color:#22333D;">Visszatérített jegyek</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px;">
    {{range .Tickets}}<tr><td>Jegy {{.Number}}{{with .Tier}} · {{.}}{{end}}{{with .Seat}} · {{.}}{{end}}{{if .Void}} · <strong>már nem érvényes</strong>{{end}}</td><td style="text-align:right;">{{.Price}}</td></tr>{{end}}
    <tr><td style="border-top:1px solid #eceff1;"><strong>Összesen visszatérítve</strong></td><td style="border-top:1px solid #eceff1;text-align:right;"><strong>{{.Refund.Total}}</strong></td></tr>
  </table>
  <p style="margin:16px 0 12px 0;">A pénz arra a fizetési módra érkezik vissza, amellyel fizetett. A bankja ezt általában 5–10 munkanap alatt jeleníti meg.</p>
  {{if .Refund.TicketsCancelled}}<p style="margin:0 0 12px 0;">A visszatérített jegyek belépésre már nem érvényesek.</p>{{else if .Refund.SomeTicketsCancelled}}<p style="margin:0 0 12px 0;">Csak a „már nem érvényes” jelzésű jegyekkel nem lehet belépni; a fenti listában szereplő többi jegy érvényes marad.</p>{{end}}
  <p style="font-size:12px;color:#666">Címzett: {{.RecipientEmail}}</p>
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    {{.Branding.SellerLabel}} <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}{{with .Branding.PaymentLine}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kapcsolat: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Kapcsolat: <a href="{{.}}" style="color:#666">Írjon a szervezőnek</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Jegykezelés: arenasoldout.com</a>{{end}}</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Ha a „Leiratkozás” gombra kattint, a jegyeit tartalmazó levelek és a rendeléséről szóló fontos levelek többé nem érkeznek meg Önhöz. Az Ön hozzájárulása nélkül nem küldünk marketinglevelet.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

