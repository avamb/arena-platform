{{define "subject"}}{{if .Shop.RefundFull}}Заказ № {{.Shop.OrderNumber}} возвращён{{else}}Возврат по заказу № {{.Shop.OrderNumber}}{{end}} — {{.Branding.OrgName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="ru" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{if .Shop.RefundFull}}Заказ возвращён{{else}}Возврат по заказу{{end}}</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .Shop.RefundFull}}Заказ возвращён{{else}}Возврат по заказу{{end}}</h1>
  <p style="margin:0 0 12px 0;">Здравствуйте{{with .HolderName}}, {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">{{if .Shop.RefundFull}}Заказ <strong>№ {{.Shop.OrderNumber}}</strong> возвращён полностью.{{else}}Мы вернули <strong>{{.Shop.RefundAmount}}</strong> по заказу <strong>№ {{.Shop.OrderNumber}}</strong>.{{end}}</p>
  <p style="margin:0 0 6px 0;font-weight:bold;color:#22333D;">Ваш заказ</p>
  <table width="100%" cellpadding="4" style="border-collapse:collapse;font-size:14px;">
    {{range .Shop.Items}}<tr><td>{{.Qty}} × {{.Title}}</td><td style="text-align:right;white-space:nowrap;">{{.LineTotal}}</td></tr>{{end}}
    <tr><td style="border-top:1px solid #eceff1;color:#46555f;">Сумма заказа</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.Shop.Total}}</td></tr>
    <tr><td style="border-top:1px solid #eceff1;color:#46555f;">Возвращено сейчас</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;"><strong>{{.Shop.RefundAmount}}</strong></td></tr>
    {{if ne .Shop.RefundedTotal .Shop.RefundAmount}}<tr><td style="border-top:1px solid #eceff1;color:#46555f;">Возвращено всего</td><td style="border-top:1px solid #eceff1;text-align:right;white-space:nowrap;">{{.Shop.RefundedTotal}}</td></tr>{{end}}
  </table>
  <p style="margin:16px 0 12px 0;">Деньги вернутся через платёжную систему на карту или другой способ оплаты, которым вы платили. Срок зависит от вашего банка.</p>
  {{with .Shop.StatusURL}}<p style="margin:16px 0 12px 0;"><a href="{{.}}" style="color:{{$.Accent}};font-weight:bold;">Статус заказа</a></p>{{end}}
  {{if .Branding.ContactEmail}}<p style="margin:0 0 12px 0;">Есть вопросы? Ответьте на это письмо.</p>{{end}}
  <p style="font-size:12px;color:#666">Письмо отправлено на: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.SellerIDs}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Контакт: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}<br>Контакт: <a href="{{.}}" style="color:#666">Написать организатору</a>{{end}}{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — автоматическое сообщение</p>
  <p style="font-size:11px;color:#999;line-height:1.5">Если вы нажмёте «Отписаться», письма с билетами и важные письма о вашем заказе к вам больше не придут. Рекламных рассылок без вашего согласия мы не отправляем.</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

