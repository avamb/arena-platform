{{define "subject"}}Veranstaltung abgesagt — {{.EventName}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="de" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Veranstaltung abgesagt</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">Ihre Veranstaltung wurde abgesagt</h1>
  <p style="margin:0 0 12px 0;">Hallo{{with .HolderName}} {{.}}{{end}},</p>
  <p style="margin:0 0 12px 0;">Der Veranstalter hat den Termin von <strong>{{.EventName}}</strong>{{with .SessionStart}}, geplant für {{.}},{{end}} abgesagt. Ihr Ticket für diesen Termin berechtigt nicht mehr zum Einlass.</p>
  <table cellpadding="4" style="border-collapse:collapse;font-size:14px">
    <tr><td><strong>Veranstaltung</strong></td><td>{{.EventName}}</td></tr>
    {{with .SessionStart}}<tr><td><strong>Termin</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .VenueName}}<tr><td><strong>Veranstaltungsort</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .TierName}}<tr><td><strong>Kategorie</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatSector}}<tr><td><strong>Sektor</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatRow}}<tr><td><strong>Reihe</strong></td><td>{{.}}</td></tr>{{end}}
    {{with .SeatNumber}}<tr><td><strong>Platz</strong></td><td>{{.}}</td></tr>{{end}}
  </table>
  {{with .Change.Message}}<div style="margin:16px 0;padding:12px 16px;border-left:3px solid {{$.Accent}};background:#f8f9fa">
    <p style="margin:0 0 6px;font-size:13px;color:#555"><strong>Nachricht des Veranstalters:</strong></p>
    <p style="margin:0;white-space:pre-line">{{.}}</p>
  </div>{{end}}
  <p style="margin:0 0 12px 0;">Bitte schreiben Sie dem Veranstalter{{with .Change.ContactName}} ({{.}}){{end}} an <a href="mailto:{{.Change.ContactEmail}}" style="color:#1a73e8">{{.Change.ContactEmail}}</a>{{with .Change.ContactPhone}}, Telefon {{.}}{{end}}, um die weiteren Schritte zu erfahren.</p>
  <p style="font-size:12px;color:#666">Ticket-ID: {{.TicketID}}</p>
  <p style="font-size:12px;color:#666">Zugestellt an: {{.RecipientEmail}}</p>
  </td></tr>
  <tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:12px;line-height:1.6;border-top:1px solid #eceff1;">
{{with .Branding.WebsiteURL}}<a href="{{.}}" style="color:#93a0a8;">{{.}}</a><br><br>{{end}}
  <p style="font-size:11px;color:#666;line-height:1.5">
    <strong>{{.Branding.LegalName}}</strong>
    {{with .Branding.LegalAddressLine1}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressLine2}}<br>{{.}}{{end}}
    {{with .Branding.LegalAddressPostalCode}}<br>{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}{{else}}{{with .Branding.LegalAddressCity}}<br>{{.}}{{end}}{{end}}
    {{with .Branding.LegalAddressCountry}}<br>{{.}}{{end}}
    {{with .Branding.ContactEmail}}<br>Kontakt: <a href="mailto:{{.}}" style="color:#666">{{.}}</a>{{end}}
  </p>
  <p style="font-size:11px;color:#999">Arena Platform — automatischer Versand</p>
  </td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}{{with .Branding.WebsiteURL}} ({{.}}){{end}}

Ihre Veranstaltung wurde abgesagt

Hallo{{with .HolderName}} {{.}}{{end}},

Der Veranstalter hat den Termin von {{.EventName}}{{with .SessionStart}}, geplant für {{.}},{{end}} abgesagt. Ihr Ticket für diesen Termin berechtigt nicht mehr zum Einlass.

Veranstaltung: {{.EventName}}
{{with .SessionStart}}Termin: {{.}}
{{end}}{{with .VenueName}}Veranstaltungsort: {{.}}
{{end}}{{with .TierName}}Kategorie: {{.}}
{{end}}{{with .SeatSector}}Sektor: {{.}}
{{end}}{{with .SeatRow}}Reihe: {{.}}
{{end}}{{with .SeatNumber}}Platz: {{.}}
{{end}}{{with .Change.Message}}
Nachricht des Veranstalters:
{{.}}
{{end}}
Bitte schreiben Sie dem Veranstalter{{with .Change.ContactName}} ({{.}}){{end}} an {{.Change.ContactEmail}}{{with .Change.ContactPhone}}, Telefon {{.}}{{end}}, um die weiteren Schritte zu erfahren.

Ticket-ID: {{.TicketID}}
Zugestellt an: {{.RecipientEmail}}

--
{{.Branding.LegalName}}
{{with .Branding.LegalAddressLine1}}{{.}}
{{end}}{{with .Branding.LegalAddressLine2}}{{.}}
{{end}}{{with .Branding.LegalAddressPostalCode}}{{.}}{{with $.Branding.LegalAddressCity}} {{.}}{{end}}
{{else}}{{with .Branding.LegalAddressCity}}{{.}}
{{end}}{{end}}{{with .Branding.LegalAddressCountry}}{{.}}
{{end}}{{with .Branding.ContactEmail}}Kontakt: {{.}}
{{end}}
