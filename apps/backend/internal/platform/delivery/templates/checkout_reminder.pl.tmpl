  <p style="margin:0 0 12px 0;">Zamówienie {{.CartReminder.OrderNumber}} · Bilety: {{.CartReminder.Tickets}} · Razem: {{.CartReminder.Total}}</p>
  {{with .CartReminder.Venue}}<p style="margin:0 0 12px 0;">Miejsce: {{.}}</p>{{end}}
  <p style="margin:16px 0 16px 0;"><a href="{{.CartReminder.URL}}" style="display:inline-block;background:{{.Accent}};color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 22px;border-radius:6px;">Przejdź do płatności</a></p>
