{{else}}{{with .Branding.LegalAddressCity}}{{.}}
{{end}}{{end}}{{with .Branding.LegalAddressCountry}}{{.}}
{{end}}{{with .Branding.SellerIDs}}{{.}}
{{end}}{{with .Branding.ContactEmail}}Contact : {{.}}
{{end}}{{if not .Branding.ContactEmail}}{{with .Branding.ContactFormURL}}Contact : {{.}}
