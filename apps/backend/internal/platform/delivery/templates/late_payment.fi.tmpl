{{define "subject"}}{{if .LatePayment.Refunding}}Maksunne tapahtumaan {{.EventName}} palautetaan{{else}}Maksustanne tapahtumaan {{.EventName}}{{end}}{{end}}

{{define "html"}}<!DOCTYPE html>
<html lang="fi" dir="ltr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Maksustanne</title></head>
<body style="margin:0;padding:0;background:#f2f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f4f5;padding:24px 0;"><tr><td align="center">
<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">
  {{with .Branding.LogoURL}}<tr><td align="center" style="background:#ffffff;padding:18px 32px 12px 32px;"><img src="{{.}}" width="160" alt="{{$.Branding.LogoAlt}}" style="display:block;width:160px;height:auto;border:0;"></td></tr>{{else}}<tr><td align="center" style="background:#ffffff;padding:20px 32px 10px 32px;font-size:18px;font-weight:bold;color:#22333D;">{{.Branding.OrgName}}</td></tr>{{end}}
  <tr><td style="background:{{.Accent}};height:3px;font-size:1px;">&nbsp;</td></tr>
  <tr><td style="padding:24px 32px 8px 32px;color:#46555f;font-size:14px;line-height:1.6;">
  <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:#22333D;">{{if .LatePayment.Refunding}}Maksunne palautetaan{{else}}Maksunne saapui tilauksen sulkeutumisen jälkeen{{end}}</h1>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.BuyerCancelled}}Peruitte tilauksen {{.LatePayment.OrderNumber}} tapahtumaan {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, mutta maksu {{.LatePayment.Total}} saapui silti meille.{{else}}Maksunne {{.LatePayment.Total}} tilauksesta {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) saapui meille tilauksen sulkeutumisen jälkeen, eikä lippuja voitu enää pitää varattuina teille.{{end}}</p>
  <p style="margin:0 0 12px 0;">{{if .LatePayment.Refunding}}Palautamme koko summan käyttämällenne maksutavalle. Pankki tarvitsee yleensä 5–10 arkipäivää, ennen kuin palautus näkyy.{{else}}Järjestäjä palauttaa teille koko summan ja ottaa teihin yhteyttä asian tiimoilta.{{end}}</p>
  <p style="margin:0 0 12px 0;">Tästä tilauksesta ei myönnetty lippuja.</p>
  {{with .LatePayment.Venue}}<p style="margin:0 0 12px 0;">{{.}}</p>{{end}}
  </td></tr>
  {{template "contact_html" .}}<tr><td style="padding:16px 32px 28px 32px;color:#93a0a8;font-size:11px;line-height:1.6;border-top:1px solid #eceff1;">{{if not .WhiteLabel}}<a href="https://arenasoldout.com" style="color:inherit;text-decoration:underline">Lippujen käsittely: arenasoldout.com</a><br>{{end}}Jos napsautatte ”Peruuta tilaus”, lippunne sisältävät viestit ja tilaustanne koskevat tärkeät viestit eivät enää saavu teille. Emme lähetä markkinointiviestejä ilman suostumustanne.</td></tr>
</table>
</td></tr></table>
</body>
</html>{{end}}

{{define "text"}}{{.Branding.OrgName}}

{{if .LatePayment.Refunding}}Maksunne palautetaan{{else}}Maksunne saapui tilauksen sulkeutumisen jälkeen{{end}}

{{if .LatePayment.BuyerCancelled}}Peruitte tilauksen {{.LatePayment.OrderNumber}} tapahtumaan {{.EventName}}{{with .LatePayment.When}} ({{.}}){{end}}, mutta maksu {{.LatePayment.Total}} saapui silti meille.{{else}}Maksunne {{.LatePayment.Total}} tilauksesta {{.LatePayment.OrderNumber}} ({{.EventName}}{{with .LatePayment.When}}, {{.}}{{end}}) saapui meille tilauksen sulkeutumisen jälkeen, eikä lippuja voitu enää pitää varattuina teille.{{end}}
{{if .LatePayment.Refunding}}Palautamme koko summan käyttämällenne maksutavalle. Pankki tarvitsee yleensä 5–10 arkipäivää, ennen kuin palautus näkyy.{{else}}Järjestäjä palauttaa teille koko summan ja ottaa teihin yhteyttä asian tiimoilta.{{end}}
Tästä tilauksesta ei myönnetty lippuja.
{{with .LatePayment.Venue}}{{.}}
{{end}}
{{template "contact_text" .}}{{if not .WhiteLabel}}Lippujen käsittely: arenasoldout.com — https://arenasoldout.com{{end}}

Jos napsautatte ”Peruuta tilaus”, lippunne sisältävät viestit ja tilaustanne koskevat tärkeät viestit eivät enää saavu teille. Emme lähetä markkinointiviestejä ilman suostumustanne.
{{end}}
