# Copy to .env.local for `npm run dev`.
VITE_API_BASE_URL=http://localhost:8080
# Event wizard (create event, 6-1c): 1 shows "Create event" and the wizard. The release Dockerfile defaults to 1; 0 is the rollback.
# VITE_FEATURE_WIZARD=1
# Own product analytics (spec 50): 1 sends screen views, flow steps and errors to POST /v1/me/t. Default 0 (off).
# A person can opt out in the top bar ("Help improve the service").
# VITE_ANALYTICS=1
