# Arena Sold Out hosted sales page — nginx configuration.
#
# Mirrors apps/admin-web/nginx.conf's conventions (port 8080 non-root,
# SPA fallback, immutable hashed-asset cache, security headers) with two
# additions specific to this app:
#   - /widget/v1/ (the self-hosted <arena-tickets> bundle, copied in from
#     the widget build stage — see Dockerfile) gets the SAME short cache as
#     index.html, since a widget release can ship independently of a page
#     deploy and must not be pinned behind a long-lived immutable cache.
#   - A Content-Security-Policy that allows this origin's own scripts/
#     styles, inline styles (required by the widget's Shadow DOM — same
#     requirement documented in docs/widget-embed.md), and XHR/fetch to the
#     configured API origin. See security-headers.conf.template for the
#     full policy — it is `include`d in every location below because nginx
#     stops inheriting add_header from the server level the moment a
#     location defines even one add_header of its own (Cache-Control here),
#     and `location = /index.html` is where almost every real request ends
#     up via the SPA catch-all's `try_files … /index.html` internal
#     redirect.

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    include /etc/nginx/snippets/security-headers.conf;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Immutable cache for content-hashed static assets produced by Vite.
    location ~* \.(js|css|woff2?|ttf|eot|otf|svg|png|jpg|jpeg|gif|ico|webp)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # The self-hosted widget bundle: short cache, NOT immutable — its
    # filename is not content-hashed (apps/widget/vite.config.ts pins the
    # output name to arena-tickets.js) and a widget release can ship
    # independently of this page's own deploys.
    location ^~ /widget/v1/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 5m;
        add_header Cache-Control "public, max-age=300" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # SPA catch-all: any path that does not match a real file (in
    # particular every /{org_slug}/{event_slug} route) is served the SPA
    # index so main.ts can resolve it client-side. Returns 200 today; true
    # server-side 404 status / OG tags need SSR — see README.md.
    location / {
        try_files $uri /index.html;
    }
}
