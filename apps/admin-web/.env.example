# Arena admin-web environment configuration.
# Copy to .env.local for local development.

# Backend HTTP API base URL (no trailing slash).
# Example: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Web event center organizers use instead of this console (no trailing slash).
# Shown on the login page and on the "staff only" screen. Default below.
# VITE_EVENT_CENTER_URL=https://events.arenasoldout.com

# Optional: enable verbose query devtools (default: dev only).
# VITE_ENABLE_QUERY_DEVTOOLS=true

# PR-07: Source map generation.
# Disabled by default. Set to "true" in CI to generate .map files as
# private artifacts for error-tracker upload. Never set in the production
# nginx container — source maps must not be publicly served.
# VITE_ENABLE_SOURCEMAPS=false
