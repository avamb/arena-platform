# Shared security headers, `include`d into every location block in
# nginx.conf.template that defines its own add_header (nginx only inherits
# add_header from an outer context when the location defines none of its own;
# same arrangement as apps/tickets-page).
#
# __API_ORIGIN__ is replaced at image build time - see Dockerfile.
#
# img-src allows https: because product pictures and organizer content may
# come from arena media on the API origin or another https host. form-action allows https: only for
# completeness: the shop never posts a form, it redirects to the provider's
# hosted payment page with a plain navigation.
# challenges.cloudflare.com (script-src, frame-src) is the Turnstile captcha
# of the checkout form (loaded only when the shop publishes a site key).
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' __API_ORIGIN__ https: data:; font-src 'self' data:; connect-src 'self' __API_ORIGIN__; frame-src https://challenges.cloudflare.com; object-src 'none'; form-action 'self' https:; frame-ancestors 'none'; base-uri 'self'" always;
