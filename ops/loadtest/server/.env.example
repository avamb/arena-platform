# Values for ops/loadtest/server/docker-compose.copy.yml. Copy to .env next to
# the compose file on the copy server (or paste into the Dokploy compose
# Environment tab). Every secret is generated fresh for the copy — never a
# production value.
#
#   openssl rand -hex 32   for each secret below

# Image tag = the production tag at the time of the run (backend-prod Raw compose).
ARENA_IMAGE_TAG=d84a4de

# Public hostnames (Cloudflare A records → the copy's IP; grey cloud first).
API_HOST=loadtest-api.arenasoldout.com
WORKER_METRICS_HOST=loadtest-worker.arenasoldout.com
# Origin the buyer "returns" to. Nothing has to be served there for the load
# test — it only has to be an allowed origin for return_url.
TICKETS_ORIGIN=https://loadtest-tickets.arenasoldout.com

POSTGRES_PASSWORD=
JWT_SIGNING_SECRET=
MEDIA_SIGNING_SECRET=
# Same value goes into the generator's prometheus.yml (authorization.credentials).
METRICS_BEARER_TOKEN=
